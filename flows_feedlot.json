    {
        "id": "fn-cargador",
        "type": "function",
        "z": "d8936887b2be8f5f",
        "name": "Control Cargador",
        "func": "const redOk = flow.get('red_ok') || false;\nconst v = parseFloat(msg.payload);\nif (!redOk) return null;\nconst cargando = flow.get('cargando') || false;\nif (v < 12.0) {\n    flow.set('cargando', true);\n    msg.payload = 'ON';\n} else if (v >= 12.6 && cargando) {\n    flow.set('cargando', false);\n    msg.payload = 'OFF';\n} else {\n    return null;\n}\nreturn msg;",
        "outputs": 1,
